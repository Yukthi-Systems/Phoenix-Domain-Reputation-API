{
  "info": {
    "_postman_id": "5e2f6b7a-9c1e-4b3a-8b0a-4f1a7c6d9e21",
    "name": "domain-reputation API",
    "description": "Domain reputation lookups backed by the IPFire Domain Blocklist (DBL). Run `go run ./cmd/server` locally, then use the `baseUrl` and `apiKey` collection variables to point at any environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "your-api-key",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Readiness",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness check. Always 200 once the process is up. Not authenticated."
          },
          "response": []
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            },
            "description": "200 once at least one IPFire snapshot has been published, otherwise 503. Not authenticated."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Domain Reputation",
      "item": [
        {
          "name": "Get reputation - known domain",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/evil.com",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "evil.com"]
            },
            "description": "Returns the aggregated score and per-category breakdown for a domain."
          },
          "response": []
        },
        {
          "name": "Get reputation - normalization (uppercase + trailing dot)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/EVIL.COM.",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "EVIL.COM."]
            },
            "description": "Input is normalized (lowercased, trailing dot stripped) before lookup."
          },
          "response": []
        },
        {
          "name": "Get reputation - unknown domain",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/example.com",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "example.com"]
            },
            "description": "An unknown domain is not an API error: 200 OK with score 0 and empty categories."
          },
          "response": []
        },
        {
          "name": "Get reputation - malformed domain",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/%2A%2A%2A",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "%2A%2A%2A"]
            },
            "description": "Invalid domain string. Expects 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Get reputation - missing/invalid API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "wrong-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/example.com",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "example.com"]
            },
            "description": "Expects 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "Get score only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domain/evil.com/score",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domain", "evil.com", "score"]
            },
            "description": "Minimal response ({domain, score}) for high-throughput consumers."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Batch",
      "item": [
        {
          "name": "Batch reputation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domains\": [\"evil.com\", \"example.com\", \"bad.com\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domains",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domains"]
            },
            "description": "Looks up reputation for multiple domains in one call. Max 1000 domains per request."
          },
          "response": []
        },
        {
          "name": "Batch reputation - empty list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domains\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reputation/domains",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reputation", "domains"]
            },
            "description": "Expects 400 Bad Request - domains must not be empty."
          },
          "response": []
        }
      ]
    }
  ]
}
